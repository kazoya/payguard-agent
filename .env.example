# PayGuard Agent environment template.
# Copy this file to .env and fill in the values yourself. Never commit .env.
# Get the sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox (app "PayGuard Agent").

# PayPal (SANDBOX ONLY: the app refuses to start unless PAYPAL_ENV=sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set after you create the webhook in the Dashboard (slice S10). Leave empty until then.
PAYPAL_WEBHOOK_ID=

# LLM (any OpenAI-compatible Chat Completions endpoint that supports tool calling)
# Examples: OpenAI https://api.openai.com/v1 , local Ollama http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional second model for the adversarial eval (S11). Leave empty to reuse the main model.
LLM_EVAL_MODEL=

# App
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/payguard.db
# Demo-only role switcher (owner | approver | clerk). This is not real authentication.
DEMO_DEFAULT_ROLE=clerk
# Optional basic-auth password for a hosted demo (S15). Leave empty when running locally.
DEMO_ACCESS_PASSWORD=

# Offline demo mode: 1 = in-memory DB, mock PayPal and a scripted demo LLM (no keys needed).
PAYGUARD_MOCK=

# Mock mode only: demo history from seed/demo.yaml is loaded on start. Set 0 for an empty demo.
PAYGUARD_SEED=
